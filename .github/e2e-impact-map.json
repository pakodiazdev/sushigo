{
  "_comment": [
    "Functional-impact map for WIP targeted Cypress selection (#560).",
    "When a PR changes any file matching an entry's `when` globs, every Cypress spec matching",
    "that entry's `run` globs is added to the [wip] targeted E2E set (on top of any .cy.ts the",
    "PR changed directly). A code change under code/api/** or code/webapp/** that matches NO",
    "entry falls back to the FULL Cypress suite — never 'no E2E'. This map only ever narrows",
    "from full when it is confident, so an incomplete entry is safe (it just runs more, not less).",
    "Globs: '*' matches within one path segment, '**' matches across segments.",
    "[e2e-test] mode ignores this map entirely — it runs only the specs the PR changed.",
    "Optional `includes: [<area>, ...]` pulls in the FULL, current `run` set of another area",
    "(transitively, cycle-safe) — use it instead of hand-copying a subset that drifts stale.",
    "Two dependency-safety rules: (1) a file with wide blast radius (a global store like",
    "auth.store.ts, a model many domains hold a foreign key to) must NOT sit in a narrow area's",
    "`when` list — leave it unmapped so it falls through to the conservative full-suite",
    "fallback instead of silently narrowing coverage. (2) if area A's model/table is a known",
    "dependency of area B's flows (e.g. Employee -> Attendance, Payroll), give A an",
    "`includes: [\"attendance\", \"payroll\"]` — narrowing must never let a shared-dependency",
    "regression escape targeted [wip] validation, and `includes` keeps that reference complete."
  ],
  "entries": [
    {
      "area": "attendance",
      "when": [
        "code/api/app/**/Attendance*",
        "code/api/app/**/Attendance*/**",
        "code/api/app/**/Punctuality*",
        "code/api/app/Services/PunctualityService.php",
        "code/api/routes/api/attendance.php",
        "code/webapp/src/**/attendance/**",
        "code/webapp/src/**/asistencia/**"
      ],
      "run": [
        "code/webapp/cypress/e2e/attendance-*.cy.ts",
        "code/webapp/cypress/e2e/punctuality-*.cy.ts"
      ]
    },
    {
      "area": "payroll",
      "when": [
        "code/api/app/**/Payroll*",
        "code/api/app/**/Payroll*/**",
        "code/api/app/Services/PayPeriodPreviewService.php",
        "code/api/app/Services/PayrollCalculator.php",
        "code/webapp/src/**/payroll/**",
        "code/webapp/src/**/nomina/**"
      ],
      "run": [
        "code/webapp/cypress/e2e/payroll-*.cy.ts",
        "code/webapp/cypress/e2e/closed-period-*.cy.ts",
        "code/webapp/cypress/e2e/reopen-reclose-period.cy.ts"
      ]
    },
    {
      "area": "employees",
      "when": [
        "code/api/app/**/Employee*",
        "code/api/app/**/Employee*/**",
        "code/api/app/**/NegotiatedExtraDay*",
        "code/api/app/**/Schedule*",
        "code/api/app/Services/SeniorityService.php",
        "code/api/app/Services/WeeklySummaryService.php",
        "code/api/routes/api/employees.php",
        "code/webapp/src/**/employees/**",
        "code/webapp/src/**/empleados/**"
      ],
      "run": [
        "code/webapp/cypress/e2e/employee-*.cy.ts",
        "code/webapp/cypress/e2e/employees*.cy.ts",
        "code/webapp/cypress/e2e/schedule-*.cy.ts",
        "code/webapp/cypress/e2e/extra-day-*.cy.ts"
      ],
      "includes": ["attendance", "payroll"]
    },
    {
      "area": "leaves-and-vacations",
      "when": [
        "code/api/app/**/Leave*",
        "code/api/app/**/Leave*/**",
        "code/api/app/**/Vacation*",
        "code/api/app/**/VacationRequests/**",
        "code/api/app/**/VacationRules/**",
        "code/api/routes/api/vacation-holidays.php",
        "code/webapp/src/**/leaves/**",
        "code/webapp/src/**/vacations/**",
        "code/webapp/src/**/solicitudes/**"
      ],
      "run": [
        "code/webapp/cypress/e2e/leave-*.cy.ts",
        "code/webapp/cypress/e2e/vacation-*.cy.ts",
        "code/webapp/cypress/e2e/holiday-*.cy.ts",
        "code/webapp/cypress/e2e/manager-approval-inbox.cy.ts"
      ]
    },
    {
      "area": "cash",
      "when": [
        "code/api/app/**/CashAdjustments/**",
        "code/api/app/**/Cash*",
        "code/api/routes/api/cash-adjustments.php",
        "code/webapp/src/**/cash/**",
        "code/webapp/src/**/caja/**"
      ],
      "run": [
        "code/webapp/cypress/e2e/cash-*.cy.ts"
      ]
    },
    {
      "area": "inventory",
      "when": [
        "code/api/app/**/Inventory/**",
        "code/api/app/**/Inventory*",
        "code/api/routes/api/inventory.php",
