      ],
      "run": [
        "code/webapp/cypress/e2e/login.cy.ts",
        "code/webapp/cypress/e2e/dev-debug-login.cy.ts",
        "code/webapp/cypress/e2e/direct-permission-manager.cy.ts",
        "code/webapp/cypress/e2e/permission-aware-sidebar.cy.ts"
      ]
    },
    {
      "area": "media-uploads",
      "when": [
        "code/api/app/**/Media/**",
        "code/api/routes/api/media.php",
        "code/webapp/src/**/media/**"
      ],
      "run": [
        "code/webapp/cypress/e2e/*-avatar-*.cy.ts",
        "code/webapp/cypress/e2e/item-media-gallery-uploader.cy.ts",
        "code/webapp/cypress/e2e/profile-*.cy.ts"
      ]
    }
  ]
}
