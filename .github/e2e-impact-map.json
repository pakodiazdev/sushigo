        "code/webapp/src/**/dishes/**",
        "code/webapp/src/**/platillos/**"
      ],
      "run": [
        "code/webapp/cypress/e2e/dishes-*.cy.ts"
      ]
    },
    {
      "area": "auth-and-permissions",
      "when": [
        "code/api/app/**/Auth/**",
        "code/api/routes/api/auth.php",
