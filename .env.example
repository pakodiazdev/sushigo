# ===========================================
# SushiGo - Docker Compose Environment Variables
# ===========================================
# Copy this file to .env and adjust values as needed
# Docker Compose will automatically load variables from .env file

# ===========================================
# Local Development - React Application Ports
# ===========================================
API_APP_PORT=8080
VITE_APP_PORT=5173

# ===========================================
# Local Development - PostgreSQL Database
# ===========================================
# NOTE: These values are NOT sensitive as they are for local Docker containers
# - Containers are ephemeral and only accessible on your local machine
# - They enable automated setup without additional manual steps
# - Never used in production (use POSTGRES_PROD_* for production)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=sushigo
POSTGRES_PORT=5432

# ===========================================
# Production - PostgreSQL Database (External)
# ===========================================
# Configure these for production deployment with external database
POSTGRES_PROD_DB=postgres
POSTGRES_PROD_HOST=your-production-database-host.example.com
POSTGRES_PROD_PORT=5432
POSTGRES_PROD_USER=your_production_user
POSTGRES_PROD_PASS=your_production_password_here

# db preview
POSTGRES_PREVIEW_DB=postgres
POSTGRES_PREVIEW_HOST=your-production-database-host.example.com
POSTGRES_PREVIEW_PORT=5432
POSTGRES_PREVIEW_USER=your_preview_user
POSTGRES_PREVIEW_PASS=your_preview_password_here

# ===========================================
# pgAdmin Configuration
# ===========================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ===========================================
# MailHog Configuration (Email Testing)
# ===========================================
MAILHOG_PORT=8025

# ===========================================
# Frontend Configuration
# ===========================================
# API URL for frontend (used by Vite in webapp)
VITE_API_URL=https://api.sushigo.local/api/v1

# HMR (Hot Module Replacement) host for Vite WebSocket
# Should match the domain you're accessing the app from
VITE_HMR_HOST=sushigo.local

# ===========================================
# E2E Testing Configuration
# ===========================================
# Base URL for Cypress E2E tests
# - For dev environment: https://sushigo.local
# - For e2e environment: https://sushigo.e2e.local
# - For direct backend testing: http://test_e2e:80
CYPRESS_baseUrl=https://sushigo.local

# ===========================================
# Backend API Configuration
# ===========================================
# Base URL for Laravel API (used by Swagger and Laravel URL generation)
APP_URL=https://api.sushigo.local
API_URL=https://api.sushigo.local

# ===========================================
# Notes
# ===========================================
# 1. All variables support default values in docker-compose files
# 2. You can override any variable by setting it in this .env file
# 3. For production, copy this file and adjust sensitive values
# 4. Never commit .env with real credentials to version control
# 5. Local dev database credentials (POSTGRES_*) are safe defaults for Docker
