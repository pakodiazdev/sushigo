# ===========================================
# SushiGo Frontend - Environment Variables
# ===========================================

# API Configuration
# -----------------
# Base URL for the backend API
# Default: http://localhost:8080/api/v1
# Production: Set to your production API URL
VITE_API_URL=https://api.sushigo.local/api/v1

# Notes:
# - This variable is used by the centralized API client (src/lib/api-client.ts)
# - All API calls use this base URL automatically
# - For production, update to your production backend URL
# - Must start with http:// or https://

# E2E Testing Configuration
# --------------------------
# Base URL for Cypress E2E tests
# Default: https://sushigo.local (dev) / https://sushigo.e2e.local (e2e)
# Used by: cypress.config.ts
# Note: This is also set in docker-compose.yml as an environment variable
# You can override it here for local development outside Docker
CYPRESS_baseUrl=https://sushigo.local
